{
  "name": "shelf",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "bun build src/server.ts --target=bun --outdir=.tmp/typecheck && tsc --project tsconfig.book-id.json",
    "lint": "bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
